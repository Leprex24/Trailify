erDiagram
    profile ||--o{ route : "tworzy"
    profile ||--o{ activity : "rejestruje"
    profile ||--o{ review : "pisze"
    profile ||--o{ poi_collection : "zbiera"
    profile ||--o{ follow : "obserwuje"
    profile ||--o{ follow : "jest obserwowany"
    profile |o--o{ point_of_interest : "zgłasza"
    profile ||--o{ feed_event : "jest autorem wpisu"
    profile ||--o{ feed_like : "lubi"
    profile ||--o{ feed_comment : "komentuje"
    feed_event ||--o{ feed_like : "ma polubienia"
    feed_event ||--o{ feed_comment : "ma komentarze"
    route |o--o| feed_event : "publikacja"
    activity |o--o| feed_event : "udostępnienie"
    review |o--o| feed_event : "ocena"
    poi_collection |o--o| feed_event : "zebranie"
    route ||--o{ review : "ma"
    route |o--o{ activity : "przebyta w"
    activity ||--o{ gps_point : "składa się z"
    point_of_interest ||--o{ poi_collection : "zebrany jako"
    route ||--o{ photo : "ma zdjęcia"
    review ||--o{ photo : "ma zdjęcia"
    point_of_interest ||--o| photo : "ma zdjęcie"

    profile {
        uuid id PK,FK "to samo id co auth.users"
        varchar email UK
        varchar display_name
        varchar avatar_url
        varchar background_url
        boolean is_private "profil prywatny"
        varchar role "USER lub ADMIN"
        varchar status "ACTIVE lub BLOCKED"
        timestamptz created_at
    }
    route {
        bigint id PK
        uuid user_id FK
        varchar name
        text description
        varchar activity_type "CYCLING RUNNING WALKING"
        boolean is_tourist
        boolean is_scenic
        boolean is_public
        double total_distance "metry"
        integer duration_seconds
        geometry geometry "LineString 4326"
        timestamptz created_at
    }
    activity {
        bigint id PK
        uuid client_id UK "unikalne z user_id"
        uuid user_id FK
        bigint route_id FK "null dla spontanicznych"
        varchar type
        timestamptz start_time
        timestamptz end_time
        double distance
        integer duration_seconds
        double avg_pace "min/km"
        integer step_count
        boolean is_shared "udostępniona; domyślnie prywatna"
        geometry geometry "LineString 4326"
        timestamptz created_at
    }
    gps_point {
        bigint id PK
        bigint activity_id FK
        double latitude
        double longitude
        double altitude
        double speed "m/s"
        timestamptz recorded_at
        boolean is_reconstructed "true = odtworzony algorytmem po utracie GPS"
    }
    review {
        bigint id PK
        uuid user_id FK "unikalne z route_id"
        bigint route_id FK
        smallint rating "1 do 5"
        text comment
        timestamptz created_at
    }
    photo {
        bigint id PK
        bigint review_id FK "dokładnie jedno z trzech"
        bigint route_id FK "dokładnie jedno z trzech"
        bigint poi_id FK "dokładnie jedno z trzech"
        varchar url
        varchar storage_key UK
        timestamptz uploaded_at
    }
    point_of_interest {
        bigint id PK
        uuid submitted_by FK "null po usunięciu konta"
        varchar name
        text description
        double latitude
        double longitude
        varchar status "PENDING APPROVED REJECTED"
        varchar category "VIEWPOINT NATURE HISTORIC CULTURE RECREATION OTHER"
        text rejection_reason
        timestamptz created_at
        geometry location "wyliczane z lat i lon"
    }
    poi_collection {
        bigint id PK
        uuid user_id FK "unikalne z poi_id"
        bigint poi_id FK
        timestamptz collected_at
    }
    follow {
        uuid follower_id PK,FK "kto obserwuje"
        uuid followee_id PK,FK "kogo obserwuje"
        timestamptz created_at
    }
    feed_event {
        bigint id PK
        uuid user_id FK "autor wpisu"
        varchar type "ROUTE_PUBLISHED ACTIVITY REVIEW POI_COLLECTED"
        bigint route_id FK "dokładnie jedno z czterech"
        bigint activity_id FK "dokładnie jedno z czterech"
        bigint review_id FK "dokładnie jedno z czterech"
        bigint collection_id FK "dokładnie jedno z czterech"
        timestamptz created_at
    }
    feed_like {
        bigint event_id PK,FK
        uuid user_id PK,FK
        timestamptz created_at
    }
    feed_comment {
        bigint id PK
        bigint event_id FK
        uuid user_id FK
        uuid reply_to_user_id FK "oznaczona osoba"
        varchar body
        timestamptz created_at
    }
